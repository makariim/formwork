{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "./formwork/guard/git-boundary --format codex"
          },
          {
            "type": "command",
            "command": "./formwork/guard/protected-files --format codex"
          }
        ]
      }
    ]
  }
}
