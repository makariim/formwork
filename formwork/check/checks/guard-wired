#!/usr/bin/env python3
"""Check every declared or claimed runtime's guard wiring.

    guard-wired <directory>

CATCHES  A project that believes it has a boundary and does not. The rule is
         written down, the adapter exists in the repository, and nothing
         connects the two. Everything looks right and nothing refuses.

A project that declares no runtime and has no guard wiring has made no claim.

Exit status:
    0   nothing claimed, or every used runtime is wired
    1   a used runtime has missing wiring
    2   the check could not run
"""
import json
import os
import re
import sys

# Where each runtime keeps its hook configuration, relative to the project.
WIRING = {
    "claude-code": ".claude/settings.json",
    "codex":       ".codex/hooks.json",
    "cursor":      ".cursor/hooks.json",
    "gemini-cli":  ".gemini/settings.json",
}
# All three guards, not one. A settings file with the other two deleted used
# to report "declared and wired".
MARKERS = ("formwork/guard/git-boundary",
           "formwork/guard/protected-files",
           "formwork/guard/quality-gate")
MARKER = MARKERS[0]

# Events that actually fire before a tool runs, or at the end of a turn.
# Anything else is a place to park a hook so it never happens.
LIVE_EVENTS = {"PreToolUse", "Stop", "SubagentStop", "preToolUse",
               "beforeShellExecution", "BeforeTool"}

# A regex is checked against names the hook can actually receive. Looking
# for a name inside regex source accepted `not_apply_patch` as a match.
TOOL_NAMES = ("Bash", "Write", "Edit", "NotebookEdit", "Task",
              "WebFetch", "Read", "Glob", "Grep", "apply_patch")
CODEX_PATCH_NAMES = ("apply_patch", "Edit", "Write")


def matcher_matches(matcher, names):
    if matcher is None:
        return True              # an omitted matcher means every tool
    try:
        return any(re.search(str(matcher), name) for name in names)
    except re.error:
        return False


def declared_runtimes(root):
    config = os.path.join(root, ".formwork.toml")
    if not os.path.exists(config):
        return set()
    try:
        text = open(config, encoding="utf-8", errors="ignore").read()
    except OSError:
        return set()
    # Accept the key wherever it sits. The configuration grew a [bindings]
    # section and three documents disagreed about where runtime lived; a
    # reader that only understood one of them broke the other.
    m = re.search(r'^\s*runtime\s*=\s*["\']([^"\']+)["\']', text, re.M)
    found = {m.group(1)} if m else set()
    # The list is optional; runtime still selects the generated role format.
    section = re.search(r'^\s*\[bindings\]\s*$([\s\S]*?)(?=^\s*\[|\Z)',
                        text, re.M)
    if section:
        listing = re.search(r'^\s*runtimes\s*=\s*\[([^]]*)\]',
                            section.group(1), re.M | re.S)
        if listing:
            found.update(re.findall(r'["\']([^"\']+)["\']', listing.group(1)))
    return found


def wired_for(text, runtime, marker):
    # A command must sit on a live event, with a matcher that reaches a tool.
    try:
        data = json.loads(text)
    except ValueError:
        return marker in text
    hooks = data.get("hooks") if isinstance(data, dict) else None
    if not isinstance(hooks, dict):
        return False
    for event, entries in hooks.items():
        if event not in LIVE_EVENTS or not isinstance(entries, list):
            continue
        if runtime == "codex" and event != "PreToolUse":
            continue
        for entry in entries:
            if not isinstance(entry, dict):
                continue
            matcher = entry.get("matcher")
            if not matcher_matches(matcher, TOOL_NAMES):
                continue
            if runtime == "codex" and marker.endswith("protected-files") and \
                    not matcher_matches(matcher, CODEX_PATCH_NAMES):
                continue
            for h in entry.get("hooks") or []:
                if not isinstance(h, dict):
                    continue
                cmd = str(h.get("command", ""))
                if marker in cmd and not cmd.strip().startswith("echo"):
                    return True
    return False


def main(argv):
    if len(argv) < 2:
        print("usage: guard-wired <directory>", file=sys.stderr)
        return 2
    root = argv[1]
    if not os.path.isdir(root):
        print("ERROR: not a directory: %s" % root, file=sys.stderr)
        return 2

    runtimes = declared_runtimes(root)
    files = {}
    for runtime, relative in WIRING.items():
        path = os.path.join(root, relative)
        if os.path.exists(path):
            try:
                files[runtime] = open(path, encoding="utf-8",
                                      errors="ignore").read()
            except OSError as e:
                print("ERROR: cannot read %s: %s" % (path, e), file=sys.stderr)
                return 2
            if any(marker in files[runtime] for marker in MARKERS):
                runtimes.add(runtime)
    if not runtimes:
        print("no runtime declared, nothing claimed")
        return 0
    missing = False
    for runtime in sorted(runtimes):
        if runtime not in WIRING:
            print("runtime '%s' is not one this kit knows how to wire" % runtime)
            missing = True
            continue
        required = MARKERS[:2] if runtime == "codex" else MARKERS
        runtime_missing = False
        for marker in required:
            if not wired_for(files.get(runtime, ""), runtime, marker):
                print("runtime '%s': %s missing %s" %
                      (runtime, WIRING[runtime], marker))
                missing = True
                runtime_missing = True
        if not runtime_missing:
            print("runtime '%s' wired in %s" % (runtime, WIRING[runtime]))
    return 1 if missing else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
